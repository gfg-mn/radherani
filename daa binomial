
n = 5
k = 2

dp = []

for i in range(n+1):
    row = []
    for j in range(k+1):
        row.append(0)
    dp.append(row)

for i in range(n+1):
    for j in range(min(i, k)+1):
        if j == 0 or j == i:
            dp[i][j] = 1
        else:
            dp[i][j] = dp[i-1][j-1] + dp[i-1][j]

print("Binomial Coefficient:", dp[n][k])
