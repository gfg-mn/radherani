
weight = [10, 20, 30]
profit = [60, 100, 120]
capacity = 50
n = len(weight)

dp = []

for i in range(n+1):
    row = []
    for j in range(capacity+1):
        row.append(0)
    dp.append(row)

for i in range(1, n+1):
    for w in range(1, capacity+1):
        if weight[i-1] <= w:
            dp[i][w] = max(profit[i-1] + dp[i-1][w-weight[i-1]],
                           dp[i-1][w])
        else:
            dp[i][w] = dp[i-1][w]

print("Maximum Profit:", dp[n][capacity])
