jobs = [('A', 2, 100), ('B', 1, 19),
        ('C', 2, 27), ('D', 1, 25), ('E', 3, 15)]

n = len(jobs)
for i in range(n):
    for j in range(0, n - i - 1):
        if jobs[j][2] < jobs[j + 1][2]:   # compare profit (index 2)
            jobs[j], jobs[j + 1] = jobs[j + 1], jobs[j]

max_deadline = 0
for job in jobs:
    if job[1] > max_deadline:
        max_deadline = job[1]

slots = [None] * n
profit = 0

for job in jobs:
    for j in range(job[1]-1, -1, -1):
        if slots[j] is None:
            slots[j] = job[0]
            profit += job[2]
            break

print("Scheduled Jobs:", [j for j in slots if j])
print("Maximum Profit:", profit)
