def iterative(n):
    a, b = 0, 1
    for i in range(n):
        print(a, end=" ")
        a, b = b, a+b
def recursive(n):
    if n <= 1:
        return n
    return recursive(n-1) + recursive(n-2)
 
n = 10
print("Non rec:", end=" ")
iterative(n)

print("\nRecursive:", end=" ")
for i in range(n):
    print(recursive(i), end=" ")
